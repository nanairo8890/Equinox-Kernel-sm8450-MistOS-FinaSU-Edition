# Gatito root stack for Equinox, FinaSU edition: FinaSU + SUSFS v2.3.0 + BBR + NoMount.
# Replaces rootstack.config, which targets KernelSU-Next.
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
CONFIG_KSU_DYNAMIC_MANAGER=y
# CONFIG_KSU_DISABLE_POLICY is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
# BRENE turns the log off at runtime
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# BBR by default instead of Equinox's CUBIC
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# NoMount (maxsteeel): built-in VFS path redirection, used by FinaSU's NoMount backend
CONFIG_NOMOUNT=y

# Kernel release of this edition: 5.10.269-Nanairo-FinaSU (mondrian_GKI.config sets -Equinox)
CONFIG_LOCALVERSION="-Nanairo-FinaSU"
